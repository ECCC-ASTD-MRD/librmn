#!/usr/bin/env python3
"""
Generate a Kerchunk manifest from an FST file.
"""
import argparse
import logging
from pathlib import Path

import rmn
import rmn.virtualizarr

log = logging.getLogger(__name__)


def get_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "-f",
        "--filename",
        type=Path,
        required=True,
        help="Input FST file (.rsf or XDF).",
    )
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        default=Path("manifest.json"),
        help="Output Kerchunk manifest.",
    )
    parser.add_argument(
        "--max-records",
        type=int,
        default=None,
        metavar="N",
        help="Only include the first N records.",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Enable verbose logging.",
    )
    return parser.parse_args()


def main():
    args = get_args()

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.WARNING,
        format="%(levelname)s %(name)s: %(message)s",
    )

    log.debug("Opening %s", args.filename)

    with rmn.fst24_file(str(args.filename)) as f:
        out = rmn.virtualizarr.generate_manifest(
            f,
            args.output,
            max_records=args.max_records,
        )

    log.debug("Manifest written: %s", out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
